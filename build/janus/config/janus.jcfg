general: {
    configs_folder = "/etc/janus"
    plugins_folder = "/usr/lib/x86_64-linux-gnu/janus/plugins"
    transports_folder = "/usr/lib/x86_64-linux-gnu/janus/transports"
    events_folder = "/usr/lib/x86_64-linux-gnu/janus/events"
    loggers_folder = "/usr/lib/x86_64-linux-gnu/janus/loggers"

    log_to_stdout = true
    debug_level = __JANUS_DEBUG_LEVEL__
    debug_colors = false

    server_name = "DVRTC Janus"
    session_timeout = 60
}

certificates: {
}

media: {
    rtp_port_range = "__JANUS_RTP_PORT_RANGE__"
}

nat: {
    nice_debug = false
}

plugins: {
    disable = "libjanus_recordplay.so,libjanus_voicemail.so,libjanus_lua.so,libjanus_duktape.so,libjanus_nosip.so,libjanus_sip.so,libjanus_streaming.so,libjanus_textroom.so,libjanus_videocall.so"
}

transports: {
    disable = "libjanus_mqtt.so,libjanus_rabbitmq.so,libjanus_nanomsg.so,libjanus_pfunix.so"
}

loggers: {
    disable = "libjanus_jsonlog.so"
}

events: {
    disable = "libjanus_sampleevh.so,libjanus_gelfevh.so,libjanus_wsevh.so,libjanus_mqttevh.so,libjanus_rabbitmqevh.so,libjanus_nanomsgevh.so"
}
